# ---------------------------  CLI EXTENSIONS  ---------------------------------
def extend_parser(p):
    g = p.add_argument_group("advanced features")
    g.add_argument("--tlskey", help="RSA key or key-log file for TLS decryption")
    g.add_argument("--kafka", metavar="HOST:PORT", help="Kafka broker to stream JSON")
    g.add_argument("--async", action="store_true", help="use AsyncSniffer")
    g.add_argument("--plugin", metavar="DIR", help="auto-load extra parsers")
    g.add_argument("--sip", action="store_true", help="enable SIP plugin (example)")
    return p

# ---------------------------  TLS DECRYPTION  ---------------------------------
class TLSHandler:
    def __init__(self, keyfile):
        self.key = self._load_key(keyfile)
        # tell Scapy to use our key
        conf.tls_session_enable = True
        conf.tls_nss_filename = keyfile if keyfile.endswith(".log") else None
        conf.tls_private_key = keyfile if not keyfile.endswith(".log") else None

    @staticmethod
    def _load_key(f):
        if not os.path.isfile(f):
            raise FileNotFoundError(f"TLS key {f}")
        return f

    def decrypt(self, pkt):
        if pkt.haslayer(TLS) or (TCP in pkt and pkt[TCP].dport in (443, 8443)):
            # Scapy will auto-decrypt if key matches
            return pkt
        return pkt

# ---------------------------  KAFKA SINK  -------------------------------------
class KafkaSink:
    def __init__(self, broker):
        self.producer = KafkaProducer(
            bootstrap_servers=broker,
            value_serializer=lambda v: json.dumps(v).encode("utf-8"),
            api_version_auto_timeout_ms=5000)

    def send(self, pkt):
        j = pkt2dict(pkt)
        self.producer.send("pcap", j)

# ---------------------------  PLUGIN LOADER  ----------------------------------
class PluginManager:
    def __init__(self, plugdir):
        self.plugdir = pathlib.Path(plugdir)
        self.hooks = {"tcp": [], "udp": [], "ip": []}
        self._load_all()

    def _load_all(self):
        for py in self.plugdir.glob("*.py"):
            try:
                spec = importlib.util.spec_from_file_location(py.stem, py)
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
                # module must expose register(hooks_dict)
                if hasattr(mod, "register"):
                    mod.register(self.hooks)
                    print(f"[+] loaded plugin {py.stem}")
            except Exception as e:
                logging.exception(f"plugin {py} failed")

    def run(self, pkt):
        L = []
        if IP in pkt:   L += self.hooks["ip"]
        if TCP in pkt:  L += self.hooks["tcp"]
        if UDP in pkt:  L += self.hooks["udp"]
        for func in L:
            try:
                func(pkt)
            except Exception:
                logging.exception("plugin error")

# ---------------------------  ASYNC SNIFFER  ----------------------------------
async def async_sniff(args, q, stop):
    from scapy.arch.bpf.supersocket import AsyncNativeSocket
    # requires Scapy ≥2.5
    sniff_opened = AsyncNativeSocket(iface=args.iface, promisc=args.promisc)
    pkt_reader = sniff_opened.sniff()
    while not stop.is_set():
        try:
            pkt = await asyncio.wait_for(pkt_reader.__anext__(), timeout=1)
            q.put(pkt)
        except asyncio.TimeoutError:
            continue

