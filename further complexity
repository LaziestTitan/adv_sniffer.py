# ---------------------------  PATCHED SNIFFER  --------------------------------
class SnifferPlus:
    def __init__(self, args):
        self.args = args
        self.writer = RotatingWriter(args.out, args.rotate) if args.rotate else None
        self.exporter = JSONExporter(args.export) if args.export else None
        self.streamer = StreamHandler() if args.reassemble else None
        self.tls = TLSHandler(args.tlskey) if args.tlskey else None
        self.kafka = KafkaSink(args.kafka) if args.kafka else None
        self.plugins = PluginManager(args.plugin) if args.plugin else None
        self.q = queue.Queue(maxsize=20000)
        self.stop_evt = threading.Event()

    def start(self):
        if self.args.async:
            asyncio.run(self._async_loop())
        else:
            self._sync_loop()

    # -------------  ASYNC BRANCH  -------------
    async def _async_loop(self):
        from scapy.arch.bpf.supersocket import AsyncNativeSocket
        sock = AsyncNativeSocket(iface=self.args.iface, promisc=True)
        async for pkt in sock.sniff():
            if self.stop_evt.is_set():
                break
            self._handle(pkt)

    # -------------  SYNC BRANCH  --------------
    def _sync_loop(self):
        for _ in range(self.args.workers):
            threading.Thread(target=self.worker, daemon=True).start()
        sniff(iface=self.args.iface,
              filter=self.args.bpf,
              prn=self.q.put,
              store=False,
              session=IPSession if self.args.reassemble else None,
              stop_filter=lambda _: self.stop_evt.is_set())

    def worker(self):
        while not self.stop_evt.is_set():
            try:
                pkt = self.q.get(timeout=.5)
            except queue.Empty:
                continue
            self._handle(pkt)

    def _handle(self, pkt):
        if self.tls:
            pkt = self.tls.decrypt(pkt)
        if self.writer:
            self.writer.write(pkt)
        if self.exporter:
            self.exporter.handle(pkt)
        if self.kafka:
            self.kafka.send(pkt)
        if self.plugins:
            self.plugins.run(pkt)
        if not self.args.quiet:
            PrettyPrinter.handle(pkt)

    def shutdown(self, sig, frame):
        print("\n[*] shutting down…")
        self.stop_evt.set()
        sys.exit(0)

# ---------------------------  MAIN  -------------------------------------------
if __name__ == "__main__":
    parser = extend_parser(argparse.ArgumentParser(description="Advanced sniffer+"))
    args = parser.parse_args()
    sniffer = SnifferPlus(args)
    signal.signal(signal.SIGINT, sniffer.shutdown)
    sniffer.start()
